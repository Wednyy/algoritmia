Proceso Informacion_Personal
    Definir nombre, ciudad, programa Como Caracter;
    Definir edad Como Entero;
	
    Escribir "Ingrese su nombre:";
    Leer nombre;
	
    Escribir "Ingrese su edad:";
    Leer edad;
	
    Escribir "Ingrese su ciudad:";
    Leer ciudad;
	
    Escribir "Ingrese su programa de formacion:";
    Leer programa;
	
    Escribir "Nombre: ", nombre;
    Escribir "Edad: ", edad;
    Escribir "Ciudad: ", ciudad;
    Escribir "Programa: ", programa;
FinProceso
